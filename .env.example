# Server-side only — never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Model powering the agentic loop. NOT freely swappable — accepts only
# claude-opus-5 / claude-opus-4-8 / claude-fable-5 (see README "On changing MODEL_ID")
MODEL_ID=claude-opus-5

# Trade-search infrastructure tuning (semantics never depend on these values)
SEARCH_TIME_BUDGET_MS=8000
VALIDATION_CONCURRENCY=4

# bball-GM API base
BBALLGM_BASE_URL=https://bball-gm.com/api

# Test wiring (composition edge only): 1 = swap in deterministic fakes
# MOCK_LLM=1
# MOCK_BBALLGM=1
